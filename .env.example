# Copy this file to .env and fill in real values. Never commit the real .env.

DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=

# Leave blank locally (uses SQLite). In production, set to either:
#   Postgres (Render/Railway/Neon): postgresql://user:pass@host:5432/dbname
#   MySQL (PythonAnywhere free tier): mysql://user:pass@user.mysql.pythonanywhere-services.com/user$dbname
DATABASE_URL=

EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=

PASSWORD_RESET_TIMEOUT=259200
